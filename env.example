# ============================================
# Travel AI Platform - Environment Variables
# انسخ هذا الملف إلى .env وضع القيم الحقيقية
# لا تقم أبدًا برفع ملف .env الحقيقي إلى Git
# ============================================

# Flask
FLASK_SECRET_KEY=change-this-to-a-random-secret-string
FLASK_ENV=production

# Database
# محليًا سيتم استخدام SQLite تلقائيًا إذا تُرك هذا فارغًا
# على Render استخدم رابط PostgreSQL الذي يوفره Render
DATABASE_URL=

# ------------------------------------------------
# AI Provider (اختياري - النظام يعمل بوضع تجريبي بدونه)
# ------------------------------------------------
AI_PROVIDER=mock
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
# AI_MODEL=claude-sonnet-4-6

# ------------------------------------------------
# Flight Data Providers (اختياري - Mock Provider يعمل افتراضيًا)
# ------------------------------------------------
FLIGHT_PROVIDER=mock
# EXAMPLE_FLIGHT_API_KEY=

# CORS - نطاقات الواجهة الأمامية المسموح بها (مفصولة بفاصلة)
ALLOWED_ORIGINS=*
